@inherits LayoutComponentBase

<div class="app-frame">
    <aside class="sidebar"><NavMenu /></aside>
    <main class="main-content">
        <header class="topbar">
            <div class="topbar-status"><span class="pulse-dot"></span> Workspace live</div>
            <span class="topbar-date">@DateTime.Now.ToString("dddd, dd MMM")</span>
        </header>
        <article class="content">@Body</article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong. <a href="." class="reload">Reload</a>
    <span class="dismiss">×</span>
</div>
