@page "/CreateCompany"
@rendermode InteractiveServer
@using JobSearcher.Models
@using JobSearcher.Models.Enums
@using JobSearcher.Services
@inject CompanyService CompanyService
@inject NavigationManager Navigation

<PageTitle>Add company · JobSearcher</PageTitle>

<section class="page-shell">
    <header class="page-header">
        <div><span class="eyebrow">New opportunity</span>
            <h1 class="page-title">Add a company</h1>
            <p class="page-lead">Capture the useful details now. You can refine everything later as the conversation
                develops.</p></div>
        <a class="btn btn-ghost" href="ShowAllCompanies">← Back to companies</a>
    </header>

    <EditForm Model="company" OnValidSubmit="CreateCompany" class="company-form glass-card">
        <DataAnnotationsValidator/>
        <div class="form-section">
            <div class="section-heading"><span>01</span>
                <div><h2>Company basics</h2>
                    <p>The opportunity and where it is based.</p></div>
            </div>
            <div class="form-grid">
                <div class="field-wide"><label class="form-label" for="company-name">Company name</label>
                    <InputText id="company-name" class="form-control" @bind-Value="company.CompanyName"
                               placeholder="e.g. Acme Studio"/>
                </div>
                <div><label class="form-label" for="position">Position</label>
                    <InputSelect id="position" class="form-select"
                                 @bind-Value="company.CompanyPosition">@foreach (var item in Enum.GetValues<CompanyPosition>())
                        {
                            <option value="@item">@Format(item.ToString())</option>
                        }
                    </InputSelect>
                </div>
                <div><label class="form-label" for="location">Location</label>
                    <InputText id="location" class="form-control" @bind-Value="company.CompanyLocation"
                               placeholder="City or remote"/>
                </div>
                <div><label class="form-label" for="status">Status</label>
                    <InputSelect id="status" class="form-select"
                                 @bind-Value="company.CompanyStatus">@foreach (var item in Enum.GetValues<CompanyStatus>())
                        {
                            <option value="@item">@Format(item.ToString())</option>
                        }
                    </InputSelect>
                </div>
                <div><label class="form-label" for="applied">Applied date</label>
                    <InputDate id="applied" class="form-control" @bind-Value="company.CompanyAppliedDate"/>
                </div>
            </div>
        </div>
        <div class="form-section">
            <div class="section-heading"><span>02</span>
                <div><h2>Links & contact</h2>
                    <p>Keep the people and source material close.</p></div>
            </div>
            <div class="form-grid">
                <div><label class="form-label" for="contact">Contact person</label>
                    <InputText id="contact" class="form-control" @bind-Value="company.CompanyContactPerson"
                               placeholder="Name or recruiter"/>
                </div>
                <div><label class="form-label" for="website">Company website</label>
                    <InputText id="website" class="form-control" @bind-Value="company.CompanyWebsite"
                               placeholder="https://"/>
                </div>
                <div class="field-wide"><label class="form-label" for="job-link">Job posting</label>
                    <InputText id="job-link" class="form-control" @bind-Value="company.CompanyJobLink"
                               placeholder="https://"/>
                </div>
            </div>
        </div>
        <div class="form-section">
            <div class="section-heading"><span>03</span>
                <div><h2>Follow-up</h2>
                    <p>Set a clear next action and save context.</p></div>
            </div>
            <div class="form-grid">
                <div><label class="form-label" for="top-mind">Follow-up date</label>
                    <InputDate id="top-mind" class="form-control" @bind-Value="company.CompanyTopOfMind"/>
                </div>
                <div><label class="form-label" for="call">Call status</label>
                    <InputSelect id="call" class="form-select"
                                 @bind-Value="company.CompanyCallOrNot">@foreach (var item in Enum.GetValues<CompanyCallOrNot>())
                        {
                            <option value="@item">@Format(item.ToString())</option>
                        }
                    </InputSelect>
                </div>
                <div class="field-wide"><label class="form-label" for="notes">Notes</label>
                    <InputTextArea id="notes" class="form-control" @bind-Value="company.CompanyMinorNotes"
                                   placeholder="Context, next steps, impressions…"/>
                </div>
            </div>
        </div>
        <footer class="form-actions"><span>All information stays in your private workspace.</span>
            <div><a class="btn btn-ghost" href="ShowAllCompanies">Cancel</a>
                <button class="btn btn-primary" type="submit"
                        disabled="@isSaving">@(isSaving ? "Saving…" : "Save company")</button>
            </div>
        </footer>
    </EditForm>
</section>

@code {
    private Company company = new();
    private bool isSaving;

    private async Task CreateCompany()
    {
        isSaving = true;
        await CompanyService.AddCompany(company);
        Navigation.NavigateTo("ShowAllCompanies");
    }

    private static string Format(string value) => System.Text.RegularExpressions.Regex.Replace(value, "([a-z])([A-Z])", "$1 $2");
}
