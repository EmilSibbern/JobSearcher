@page "/ShowAllCompanies"
@using JobSearcher.Models
@using JobSearcher.Components.Pages.Items
@using JobSearcher.Services
@inject CompanyService CompanyService
@rendermode InteractiveServer
<h3>ShowAllCompanies</h3>


<table class="table table-dark table-striped">
    <thead>
    <tr>
        <th>Id</th>
        <th>Company Name</th>
        <th>Position</th>
        <th>Location</th>
        <th>Status</th>
        <th>Applied Date</th>
        <th>Notes</th>
        <th>Job link</th>
        <th>Contact Person</th>
        <th>Top of mind</th>
        <th>Website</th>
        <th>Call or not</th>
        <th>Edit</th>
        <th>Delete</th>
    </tr>
    </thead>

    <tbody>
    @foreach (var company in _companies)
    {
        <CompanyItem Company="company" OnValidSubmitCallback="HandleUpdate" OnDeleteCallback="DeleteCompany"/>
    }
    </tbody>
</table>

@code {

    private List<Company> _companies = new();

    private async Task HandleUpdate(Company company)
    {
        if (company.Id == 0)
        {
            await CompanyService.AddCompany(company);
        }
        else
        {
            await CompanyService.UpdateCompany(company);
        }

        _companies = await CompanyService.GetCompanies();
    }

    private async Task DeleteCompany(Company company)
    {
        await CompanyService.RemoveCompany(company);
        _companies = await CompanyService.GetCompanies();
    }

    protected override async Task OnInitializedAsync()
    {
        _companies = await CompanyService.GetCompanies();
    }

}
