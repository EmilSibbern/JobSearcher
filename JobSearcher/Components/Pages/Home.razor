@page "/"

<PageTitle>Overview · JobSearcher</PageTitle>

<section class="page-shell home-hero">
    <div class="hero-copy">
        <div class="hero-badge"><span></span>Your next chapter starts here</div>
        <h1>Turn the job search into a <em>clear process.</em></h1>
        <p>Keep every opportunity, conversation, and follow-up in one calm workspace—so you can focus on making the right next move.</p>
        <div class="hero-actions">
            <a class="btn btn-primary" href="CreateCompany">Add an opportunity <span aria-hidden="true">→</span></a>
            <a class="btn btn-outline-light" href="ShowAllCompanies">View pipeline</a>
        </div>
    </div>

    <div class="workflow-grid" aria-label="Job search workflow">
        <article class="workflow-card glass-card"><span class="step">01</span><div class="card-icon">＋</div><h2>Capture</h2><p>Save promising companies as soon as they catch your attention.</p></article>
        <article class="workflow-card glass-card featured"><span class="step">02</span><div class="card-icon">◇</div><h2>Track</h2><p>Keep applications, contacts, interviews, and notes in context.</p></article>
        <article class="workflow-card glass-card"><span class="step">03</span><div class="card-icon">↗</div><h2>Follow up</h2><p>Know who to call and when to put yourself top of mind.</p></article>
    </div>
</section>
