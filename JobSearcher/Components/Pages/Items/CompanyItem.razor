@using JobSearcher.Models
@using JobSearcher.Models.Enums
@using Microsoft.AspNetCore.Components.Forms
<EditForm Model="Company" OnValidSubmit="HandleSubmit" FormName="CompanyForm">

    <DataAnnotationsValidator/>
    <ValidationSummary/>
    <InputText @bind-Value="Company.CompanyName" placeholder="Company Name"/>
    <InputSelect @bind-Value="Company.CompanyPosition">
        @foreach (var position in Enum.GetValues<CompanyPosition>())
        {
            <option value="@position">@position</option>
        }
    </InputSelect>
    <InputText @bind-Value="Company.CompanyLocation" placeholder="Location"/>
    <InputSelect @bind-Value="Company.CompanyStatus">
        @foreach (var status in Enum.GetValues<CompanyStatus>())
        {
            <option value="@status">@status</option>
        }
    </InputSelect>
    <InputText @bind-Value="Company.CompanyMinorNotes" placeholder="Minor notes"/>
    <InputText @bind-Value="Company.CompanyJobLink" placeholder="Job post link"/>
    <InputText @bind-Value="Company.CompanyContactPerson" placeholder="Contact person"/>
    <InputText @bind-Value="Company.CompanyWebsite" placeholder="website"/>
    <InputSelect @bind-Value="Company.CompanyCallOrNot">
        @foreach (var callOrNot in Enum.GetValues<CompanyCallOrNot>())
        {
            <option value="@callOrNot">@callOrNot</option>
        }
    </InputSelect>

    <button type="submit">
        @(Company.Id == 0 ? "create" : "update")
    </button>

</EditForm>


@code {
    [Parameter] public Company Company { get; set; } = new();
    [Parameter] public EventCallback<Company> OnValidSubmitCallback { get; set; }

    private async Task HandleSubmit()
    {
        await OnValidSubmitCallback.InvokeAsync(Company);
    }


}
